# Cloudflare Pages matches request paths, and the app is loaded as "/" — a rule
# for /index.html alone would never fire. Both are listed so a tab left open
# across a deploy always revalidates the HTML, instead of holding on to stale
# references to content-hashed chunk filenames that no longer exist.
/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache

# Filenames change whenever their content does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app requests route files as /<trip>.geojson?v=<content hash> (see
# virtual:route-versions in vite.config.js), so a changed file always gets a
# new URL and each URL's content never changes. index.html, which carries the
# hashes, is no-cache above.
/*.geojson
  Cache-Control: public, max-age=31536000, immutable
